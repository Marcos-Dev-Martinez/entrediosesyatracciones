rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// REGLAS DE FIRESTORE — Entre Dioses y Atracciones / Coasterle
// Proyecto: quiz-entrediosesyatracciones
//
// SUSTITUYEN a las reglas de prueba, que caducaron el 20 de junio de 2026.
// Desde esa fecha Firebase deniega TODAS las peticiones: por eso el ranking
// se quedaba en "Cargando ranking..." y las estadísticas en guiones.
// Estas reglas no caducan.
//
// Colecciones cubiertas (las que usa coasterle.html):
//   usuarios       → racha y totales de quien entra con Google
//   resultados     → una partida por jugador y día
//   stats_diarias  → contadores globales del día
//
// Si algún otro archivo del proyecto usa otra colección, habrá que
// añadirla aquí: lo que no esté declarado queda bloqueado.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USUARIOS ────────────────────────────────────────────────────────
    // Solo existen para quien entra con Google. Cada uno es dueño del suyo:
    // nadie puede leer ni tocar la ficha de otra persona.
    match /usuarios/{uid} {

      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if
           request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'photoURL', 'streak',
              'lastPlayedDay', 'totalPlayed', 'totalWins'])
        && request.resource.data.uid == uid
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 5000
        && request.resource.data.lastPlayedDay is string
        && request.resource.data.lastPlayedDay.size() == 10;

      allow delete: if false;
    }

    // ── RESULTADOS ──────────────────────────────────────────────────────
    // Una partida por jugador y día. El identificador del documento es
    // "AAAA-MM-DD_uid", y aquí se exige que coincida con los datos: así
    // nadie puede sembrar documentos sueltos por la colección.
    //
    // Los jugadores anónimos también escriben aquí (su uid empieza por
    // "anon_"), así que no se puede exigir login. A quien SÍ entra con
    // Google se le exige que el uid coincida con su cuenta, de modo que
    // no pueda hacerse pasar por otro.
    match /resultados/{resultadoId} {

      allow read: if true;

      allow create, update: if
           resultadoId == request.resource.data.date + '_' + request.resource.data.userId
        && request.resource.data.keys().hasOnly(
             ['userId', 'nickname', 'photoURL', 'date',
              'won', 'attempts', 'streak', 'emojis', 'ts'])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() <= 128
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.won is bool
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 1
        && request.resource.data.attempts <= 6
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.emojis is string
        && request.resource.data.emojis.size() <= 600
        && (request.auth == null
            || request.auth.uid == request.resource.data.userId);

      allow delete: if false;
    }

    // ── ESTADÍSTICAS DIARIAS ────────────────────────────────────────────
    // Un documento por día con los contadores globales. Lo importante:
    // los contadores solo pueden SUBIR, y de uno en uno. Nadie puede
    // ponerlos a cero ni inflarlos de golpe.
    match /stats_diarias/{dia} {

      allow read: if true;

      allow create: if
           dia.size() == 10
        && request.resource.data.keys().hasOnly(
             ['total', 'wins', 'totalAttempts', 'dist'])
        && request.resource.data.total == 1
        && request.resource.data.wins >= 0
        && request.resource.data.wins <= 1
        && request.resource.data.totalAttempts >= 1
        && request.resource.data.totalAttempts <= 6
        && request.resource.data.dist is map;

      allow update: if
           request.resource.data.keys().hasOnly(
             ['total', 'wins', 'totalAttempts', 'dist'])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.wins <= resource.data.wins + 1
        && request.resource.data.totalAttempts >= resource.data.totalAttempts + 1
        && request.resource.data.totalAttempts <= resource.data.totalAttempts + 6
        && request.resource.data.dist is map;

      allow delete: if false;
    }

    // ── TODO LO DEMÁS, CERRADO ──────────────────────────────────────────
    // Cualquier colección que crees en el futuro nace bloqueada hasta que
    // le escribas sus reglas aquí arriba. Es lo correcto: mejor que algo
    // no funcione y te enteres, a que quede abierto sin que lo sepas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
